{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "gate",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gate",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "T64_WERROR": "ON"
      },
      "warnings": { "dev": true, "uninitialized": true },
      "errors": { "dev": true }
    },
    {
      "name": "asan",
      "description": "AddressSanitizer and UBSan build of everything; not part of the gate",
      "inherits": "gate",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "gate", "configurePreset": "gate" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    {
      "name": "gate",
      "configurePreset": "gate",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "jobs": 4 }
    },
    {
      "name": "asan",
      "inherits": "gate",
      "configurePreset": "asan"
    }
  ],
  "workflowPresets": [
    {
      "name": "gate",
      "description": "Configure, build and CTest only. The full gate is scripts/gate.sh, which also runs sh -n, the lint selftest and core-lint",
      "steps": [
        { "type": "configure", "name": "gate" },
        { "type": "build", "name": "gate" },
        { "type": "test", "name": "gate" }
      ]
    }
  ]
}
